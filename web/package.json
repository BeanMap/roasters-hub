{
  "name": "web",
  "version": "0.2.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --reporter=verbose",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts --reporter=verbose",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test e2e/specs/smoke",
    "e2e:full": "playwright test e2e/specs/journeys",
    "e2e:debug": "playwright test --headed --project=chromium",
    "e2e:ui": "playwright test --ui",
    "e2e:update-snapshots": "playwright test --update-snapshots",
    "postinstall": "prisma generate",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "vercel-build": "node scripts/vercel-build.mjs",
    "db:local:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:local:reset": "prisma migrate reset --force --skip-seed && npm run db:seed:demo",
    "db:seed:demo": "tsx prisma/seed.ts && tsx prisma/seed_cafes.ts && tsx prisma/seed_cafe_roasters_explicit.ts && tsx prisma/seed_user_profiles.ts && tsx prisma/seed_reviews.ts && tsx prisma/verify-production.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.39.8",
    "@neondatabase/serverless": "^1.0.2",
    "@prisma/adapter-neon": "^7.10.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@types/leaflet": "^1.9.21",
    "@uploadthing/react": "^7.3.3",
    "@uploadthing/shared": "^7.1.10",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.577.0",
    "next": "^16.4.4",
    "next-intl": "^4.9.1",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0",
    "resend": "^6.9.4",
    "slugify": "^1.6.8",
    "tailwind-merge": "^3.5.0",
    "uploadthing": "^7.7.4",
    "zod": "^4.6.7"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.2",
    "dotenv": "^16.4.7",
    "eslint": "^9",
    "eslint-config-next": "^16.4.4",
    "playwright": "^1.59.1",
    "png-to-ico": "^3.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.2"
  },
  "overrides": {
    "express": "^5.3.0",
    "proxy-addr": "^2.0.8",
    "body-parser": "^2.4.0"
  }
}
